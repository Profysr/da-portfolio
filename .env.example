GITHUB_TOKEN=your-key

# Upstash Vector index (created with embedding model BAAI/bge-m3 or openai/text-embedding-3-small)
UPSTASH_VECTOR_REST_URL=https://your-index.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your-token

UPSTASH_REDIS_REST_URL="https://your-index.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# Google AI Studio (Gemini) — fallback model
GEMINI_API_KEY=your-key

# Groq (primary model) — get key from console.groq.com
GROQ_API_KEY=your-key
